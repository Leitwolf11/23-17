# These flags apply to our C++ targets. External libraries use their own options.
_WARNINGS = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wfatal-errors",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wsign-compare",
    "-Wfloat-conversion",
    "-Wdouble-promotion",
    "-Wfloat-equal",
    "-Wcast-qual",
    "-Wenum-conversion",
    "-Warray-bounds",
    "-Wnull-dereference",
    "-Wformat=2",
    "-Wformat-security",
    "-Wformat-nonliteral",
    "-Wreturn-local-addr",
    "-Wsizeof-pointer-memaccess",
    "-Wfree-nonheap-object",
    "-Wshadow",
    "-Wmissing-field-initializers",
    "-Wparentheses",
    "-Wimplicit-fallthrough",
    "-Wswitch",
    "-Wswitch-enum",
    "-Wreturn-type",
    "-Waddress",
    "-Wdeprecated-declarations",
    "-Wredundant-decls",
    "-Wundef",
    "-Wpointer-arith",
    "-Wunused",
    "-Wunused-variable",
    "-Wunused-function",
    "-Wunused-parameter",
    "-Wunused-label",
    "-Wunused-value",
    "-Wunused-result",
    "-Wunused-macros",
    "-Wunused-but-set-variable",
    "-Wunused-but-set-parameter",
    "-Wold-style-cast",
    "-Wnon-virtual-dtor",
    "-Wdelete-non-virtual-dtor",
    "-Wzero-as-null-pointer-constant",
    "-Wdeprecated-copy",
    "-Wpessimizing-move",
    "-Wredundant-move",
    "-Winvalid-offsetof",
]

COPTS = select({
    "@platforms//os:windows": ["/std:c++20", "/utf-8", "/clang:-fno-exceptions"] +
                             ["/clang:" + flag for flag in _WARNINGS],
    "//conditions:default": ["-std=c++20", "-fno-exceptions"] + _WARNINGS,
})
DESKTOP = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})
