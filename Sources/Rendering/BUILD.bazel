load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//Build:Cpp.bzl", "COPTS", "DESKTOP")

cc_library(
    name = "rendering",
    srcs = [
        "GltfMaterials.cpp",
        "GltfMaterials.hpp",
        "GpuPipelines.cpp",
        "GpuPipelines.hpp",
        "GpuRenderer.cpp",
        "Renderer.cpp",
        "ScannedMesh.cpp",
        "SceneOpenGl.inc",
        "SceneSpirv.inc",
        "World.cpp",
    ] + select({
        "@platforms//os:macos": [":metal_library"],
        "//conditions:default": ["OpenGlRenderer.cpp"],
    }),
    copts = COPTS,
    target_compatible_with = DESKTOP,
    visibility = ["//Sources/Game:__pkg__", "//Tests/Rendering:__pkg__"],
    deps = [
        ":gltf",
        ":lighting",
        "//Headers/Rendering:rendering",
        "@rules_cc//cc/runfiles",
        "@sdl3//:sdl3",
    ] + select({
        "@platforms//os:macos": [":metal_bridge"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "gltf",
    srcs = ["GltfImplementation.c"],
    visibility = ["//Sources/Game:__pkg__"],
    deps = ["@cgltf"],
)

cc_library(
    name = "lighting",
    srcs = ["Lighting.cpp"],
    hdrs = ["Vector.hpp"],
    copts = COPTS,
    target_compatible_with = DESKTOP,
    visibility = ["//Tests/Rendering:__pkg__"],
    deps = ["//Headers/Rendering:rendering"],
)

cc_binary(
    name = "reference",
    srcs = ["Reference.cpp"],
    data = [
        "//Assets/Materials:surfaces.png",
        "//Assets/Reference:reference_assets",
    ],
    copts = COPTS,
    target_compatible_with = DESKTOP,
    deps = [
        ":rendering",
        "//Headers/Rendering:rendering",
        "@rules_cc//cc/runfiles",
        "@sdl3//:sdl3",
    ],
)

objc_library(
    name = "metal_bridge",
    srcs = ["MetalBridge.mm"],
    copts = COPTS,
    sdk_frameworks = ["Foundation", "Metal"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//Headers/Rendering:rendering"],
)

genrule(
    name = "metal_library",
    srcs = glob(["Metal/*.metal"]),
    outs = ["SceneMetallib.inc"],
    tools = ["//Build:CompileMetalLibrary.py"],
    cmd = "python3 $(location //Build:CompileMetalLibrary.py) $@ $(SRCS)",
    target_compatible_with = ["@platforms//os:macos"],
    exec_compatible_with = ["@platforms//os:macos"],
)
