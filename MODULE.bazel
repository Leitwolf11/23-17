bazel_dep(name = "sdl3", version = "3.4.16")
bazel_dep(name = "progmasoft_catch3", version = "0.4.0", dev_dependency = True)

archive_override(
    module_name = "progmasoft_catch3",
    integrity = "sha256-eLKJVnHILYrd/ECNpaltIekEujLcR2bXxhrJFN4DhVY=",
    strip_prefix = "catch3-a4f85cbc1214f44ac5a637fe5149f96822f52f42",
    urls = ["https://github.com/Progmasoft/catch3/archive/a4f85cbc1214f44ac5a637fe5149f96822f52f42.tar.gz"],
)

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

